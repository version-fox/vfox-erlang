{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr create *", "effect": "allow" },
    { "action": "shell", "resource": "gh pr comment *", "effect": "allow" },
    { "action": "shell", "resource": "vfox plugin test *", "effect": "allow" },
    { "action": "shell", "resource": "stylua *", "effect": "allow" },
    { "action": "shell", "resource": "gofmt *", "effect": "allow" },
    { "action": "shell", "resource": "go test *", "effect": "allow" },
    { "action": "shell", "resource": "go vet *", "effect": "allow" },
    { "action": "shell", "resource": "ruff *", "effect": "allow" },
    { "action": "shell", "resource": "actionlint*", "effect": "allow" },
    { "action": "shell", "resource": "lua-language-server *", "effect": "allow" },
    { "action": "shell", "resource": "docker build *", "effect": "allow" },
    { "action": "shell", "resource": "docker run --rm *", "effect": "allow" }
  ]
}
